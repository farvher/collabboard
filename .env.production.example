# ═══════════════════════════════════════════════════════════
# CollabBoard — Production Environment Variables
# Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=collabboard
POSTGRES_USER=collabboard
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─── MinIO (Object Storage) ──────────────────────────────
MINIO_ROOT_USER=collabboard-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret_key
MINIO_BUCKET_NAME=collabboard

# ─── JWT Authentication ──────────────────────────────────
# Must be at least 32 characters. Generate with:
# openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# ─── Application URLs ────────────────────────────────────
# The public-facing API URL (used by frontend to reach backend)
PUBLIC_API_URL=https://api.collabboard.yourdomain.com

# ─── Docker Images ───────────────────────────────────────
# Override if not using default GHCR paths
# BACKEND_IMAGE=ghcr.io/your-org/collabboard/backend:v1.0.0
# FRONTEND_IMAGE=ghcr.io/your-org/collabboard/frontend:v1.0.0

# ─── Nginx Ports ─────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443

# ─── Spring Boot (passed to backend container) ───────────
# SPRING_PROFILES_ACTIVE is set in docker-compose.prod.yml
# Add overrides here if needed:
# JAVA_OPTS=-Xms512m -Xmx1024m
